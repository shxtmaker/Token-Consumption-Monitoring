<Application x:Class="TokenUsageMonitorV3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TokenUsageMonitorV3.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <conv:ConnectionToBrushConverter x:Key="ConnBrush"/>
        <conv:LevelToBrushConverter x:Key="LevelBrush"/>
        <conv:ProgressConverter x:Key="Progress"/>
        <conv:StringToVisibilityConverter x:Key="StrVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </Application.Resources>
</Application>
