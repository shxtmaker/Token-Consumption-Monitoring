<Window x:Class="TokenConsumptionMonitoring.UI.DeepSeekLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="登录 DeepSeek 控制台" Width="900" Height="700"
        WindowStyle="ToolWindow" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#FF181B20" ShowActivated="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="12,8">
            <Button Content="完成（我已登录）" Padding="14,6" DockPanel.Dock="Right" Click="Done_Click"/>
            <Button Content="重新加载" Padding="14,6" DockPanel.Dock="Right" Margin="0,0,8,0" Click="Reload_Click"/>
            <TextBlock Text="请在下方登录 platform.deepseek.com，登录完成后点「完成」" Foreground="#8A8F98" FontSize="12"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <wv2:WebView2 x:Name="DeepSeekWebView" Grid.Row="1"/>
    </Grid>
</Window>
