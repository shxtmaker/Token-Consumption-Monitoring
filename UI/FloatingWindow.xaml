<Window x:Class="TokenConsumptionMonitoring.UI.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TokenConsumptionMonitoring" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" Width="318" SizeToContent="Height"
        MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <Border x:Name="Root" CornerRadius="8" Background="#FF16181D"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseLeftButtonUp="Root_MouseLeftButtonUp"
            MouseMove="Root_MouseMove">
        <StackPanel Margin="12,8,12,8">
            <!-- 头部：组件名称（点击切换页面）+ 状态点 + [刷新][编辑][锁定] -->
            <DockPanel Margin="0,0,0,6">
                <Button x:Name="LockBtn" DockPanel.Dock="Right" Padding="8,1" Background="Transparent"
                        BorderThickness="0" Foreground="#8A8F98" Cursor="Hand" Click="Lock_Click"
                        ToolTip="锁定：不可拖动且置顶">
                    <Path Stroke="{Binding Foreground, ElementName=LockBtn}" StrokeThickness="1.2"
                          Width="11" Height="12" Stretch="Uniform"
                          Data="M2,5.5 h7 v5.5 h-7 z M3.6,5.5 V4 a1.9,1.9 0 0 1 3.8,0 v1.5"/>
                </Button>
                <Button DockPanel.Dock="Right" Content="编辑" Padding="8,1" FontSize="11"
                        Background="Transparent" BorderThickness="0" Foreground="#8FAFDB"
                        Cursor="Hand" Click="OpenPanel_Click" ToolTip="打开编辑面板（页面/诊断）"/>
                <Button DockPanel.Dock="Right" Content="刷新" Padding="8,1" FontSize="11"
                        Background="Transparent" BorderThickness="0" Foreground="#8FAFDB"
                        Cursor="Hand" Click="Refresh_Click" Margin="0,0,4,0" ToolTip="强制刷新获取最新信息"/>
                <Button x:Name="AccountBtn" DockPanel.Dock="Left" Content="{Binding AccountName}"
                        Padding="0,1" FontSize="11" FontWeight="SemiBold"
                        Background="Transparent" BorderThickness="0" Foreground="#EEF1F5"
                        Cursor="Hand" Click="AccountBtn_Click" ToolTip="单击切换页面"/>
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" VerticalAlignment="Center" Margin="6,0,0,0"
                         Fill="{Binding Connection, Converter={StaticResource ConnBrush}}"/>
                <TextBlock Text="{Binding ConnectionLabel}" Foreground="#8A8F98" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,6,0"/>
            </DockPanel>

            <!-- 窗口能力：按快照动态列出（名称与数量来自快照，不预设 5h/周/月） -->
            <StackPanel Visibility="{Binding Snapshot.HasWindows, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Snapshot.Windows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/><ColumnDefinition Width="92"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#C7CBD3" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Grid.Column="1" Height="6" Maximum="100" BorderThickness="0" Background="#2E323A"
                                             Value="{Binding Percent, Converter={StaticResource Progress}, Mode=OneWay}"
                                             Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"
                                             VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding PercentLabel}" Foreground="#EEF1F5"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding Countdown}" Foreground="#EEF1F5" FontSize="11"
                                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 报告用量：总量 + 金额 + 模型行 -->
            <StackPanel Visibility="{Binding Snapshot.HasReportedUsage, Converter={StaticResource BoolVis}}" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock Text="用量" Foreground="#C7CBD3" FontSize="11"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Snapshot.ReportedUsageLabel}" Foreground="#EEF1F5"
                               FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Snapshot.TotalCostLabel}" Foreground="#7FC9A0"
                               FontSize="11" Margin="8,0,0,0"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Snapshot.ModelRows}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#C7CBD3" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding TokensLabel}" Foreground="#EEF1F5"
                                           FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 余额/额度 -->
            <TextBlock Text="{Binding Snapshot.BalanceLabel}" Foreground="#7FC9A0" FontSize="12" FontWeight="SemiBold"
                       Visibility="{Binding Snapshot.HasBalance, Converter={StaticResource BoolVis}}" Margin="0,4,0,0"/>

            <!-- 状态条：连接正常但无用量 / 需要鉴权 / 数据过期 / 暂无数据 -->
            <TextBlock Text="{Binding Snapshot.StatusLabel}" Foreground="#9A9A9A" FontSize="11"
                       Margin="0,6,0,0" TextWrapping="Wrap"/>

            <!-- 底部：最后更新时间 -->
            <TextBlock HorizontalAlignment="Right" Text="{Binding LastSuccessLabel}" Foreground="#EEF1F5" FontSize="11"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
