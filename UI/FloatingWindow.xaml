<Window x:Class="TokenUsageMonitorV3.UI.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Token Usage" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" Width="318" SizeToContent="Height"
        MouseLeftButtonDown="Root_MouseLeftButtonDown">
    <Border x:Name="Root" CornerRadius="8" Background="#FF16181D"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseLeftButtonUp="Root_MouseLeftButtonUp"
            MouseMove="Root_MouseMove">
        <StackPanel Margin="12,8,12,8">
            <!-- 头部：组件名称（最左，点击切换账户）+ 状态点/状态 → 右侧 [刷新][编辑] -->
            <DockPanel Margin="0,0,0,6">
                <!-- 锁定（最右）：激活=不可拖动且置顶；解锁=可拖动、可被覆盖 -->
                <Button x:Name="LockBtn" DockPanel.Dock="Right" Padding="8,1" Background="Transparent"
                        BorderThickness="0" Foreground="#8A8F98" Cursor="Hand" Click="Lock_Click"
                        ToolTip="锁定：不可拖动且置顶">
                    <Path Stroke="{Binding Foreground, ElementName=LockBtn}" StrokeThickness="1.2"
                          Width="11" Height="12" Stretch="Uniform"
                          Data="M2,5.5 h7 v5.5 h-7 z M3.6,5.5 V4 a1.9,1.9 0 0 1 3.8,0 v1.5"/>
                </Button>
                <Button DockPanel.Dock="Right" Content="编辑" Padding="8,1" FontSize="11"
                        Background="Transparent" BorderThickness="0" Foreground="#8FAFDB"
                        Cursor="Hand" Click="OpenPanel_Click" ToolTip="打开编辑面板（页面/供应商管理）"/>
                <Button DockPanel.Dock="Right" Content="刷新" Padding="8,1" FontSize="11"
                        Background="Transparent" BorderThickness="0" Foreground="#8FAFDB"
                        Cursor="Hand" Click="Refresh_Click" Margin="0,0,4,0" ToolTip="强制刷新获取最新信息"/>
                <Button x:Name="AccountBtn" DockPanel.Dock="Left" Content="{Binding AccountName}"
                        Padding="0,1" FontSize="11" FontWeight="SemiBold"
                        Background="Transparent" BorderThickness="0" Foreground="#EEF1F5"
                        Cursor="Hand" Click="AccountBtn_Click" ToolTip="单击切换账户"/>
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" VerticalAlignment="Center" Margin="6,0,0,0"
                         Fill="{Binding Connection, Converter={StaticResource ConnBrush}}"/>
                <TextBlock Text="{Binding ConnectionLabel}" Foreground="#8A8F98" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,6,0"/>
            </DockPanel>

            <!-- ===== OpenCode 视图：三窗口 + 官方用量 ===== -->
            <StackPanel Visibility="{Binding IsOpenCodeAccount, Converter={StaticResource BoolVis}}">
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/><ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Rolling.Name}" Foreground="#C7CBD3" FontSize="12" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" BorderThickness="0" Background="#2E323A"
                                 Value="{Binding Rolling.Percent, Converter={StaticResource Progress}, Mode=OneWay}"
                                 Foreground="{Binding Rolling.Level, Converter={StaticResource LevelBrush}}"
                                 VerticalAlignment="Center" Margin="4,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Rolling.PercentLabel}" Foreground="#EEF1F5"
                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <!-- 倒计时定宽槽位：值右对齐 + 单位定宽，三行左右边缘严格对齐 -->
                    <Grid Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="14"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Rolling.CountdownV1}" Foreground="#EEF1F5" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="1" Text="{Binding Rolling.CountdownU1}" Foreground="#EEF1F5" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="{Binding Rolling.CountdownV2}" Foreground="#EEF1F5" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding Rolling.CountdownU2}" Foreground="#EEF1F5" FontSize="11"/>
                        <TextBlock Grid.Column="5" Text="重置" Foreground="#EEF1F5" FontSize="11" Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/><ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <!-- 标签逐字加 0.7px 字距：总宽对齐“5h滚动”（名称与 MonitorState 保持一致） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="周" Foreground="#C7CBD3" FontSize="12"/>
                        <TextBlock Text="用" Foreground="#C7CBD3" FontSize="12" Margin="0.7,0,0,0"/>
                        <TextBlock Text="量" Foreground="#C7CBD3" FontSize="12" Margin="0.7,0,0,0"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" BorderThickness="0" Background="#2E323A"
                                 Value="{Binding Weekly.Percent, Converter={StaticResource Progress}, Mode=OneWay}"
                                 Foreground="{Binding Weekly.Level, Converter={StaticResource LevelBrush}}"
                                 VerticalAlignment="Center" Margin="4,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Weekly.PercentLabel}" Foreground="#EEF1F5"
                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Grid Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="14"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Weekly.CountdownV1}" Foreground="#EEF1F5" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="1" Text="{Binding Weekly.CountdownU1}" Foreground="#EEF1F5" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="{Binding Weekly.CountdownV2}" Foreground="#EEF1F5" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding Weekly.CountdownU2}" Foreground="#EEF1F5" FontSize="11"/>
                        <TextBlock Grid.Column="5" Text="重置" Foreground="#EEF1F5" FontSize="11" Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/><ColumnDefinition Width="92"/>
                    </Grid.ColumnDefinitions>
                    <!-- 标签逐字加 0.7px 字距：总宽对齐“5h滚动”（名称与 MonitorState 保持一致） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="月" Foreground="#C7CBD3" FontSize="12"/>
                        <TextBlock Text="用" Foreground="#C7CBD3" FontSize="12" Margin="0.7,0,0,0"/>
                        <TextBlock Text="量" Foreground="#C7CBD3" FontSize="12" Margin="0.7,0,0,0"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Height="6" Maximum="100" BorderThickness="0" Background="#2E323A"
                                 Value="{Binding Monthly.Percent, Converter={StaticResource Progress}, Mode=OneWay}"
                                 Foreground="{Binding Monthly.Level, Converter={StaticResource LevelBrush}}"
                                 VerticalAlignment="Center" Margin="4,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Monthly.PercentLabel}" Foreground="#EEF1F5"
                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Grid Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="14"/><ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Monthly.CountdownV1}" Foreground="#EEF1F5" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="1" Text="{Binding Monthly.CountdownU1}" Foreground="#EEF1F5" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="{Binding Monthly.CountdownV2}" Foreground="#EEF1F5" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{Binding Monthly.CountdownU2}" Foreground="#EEF1F5" FontSize="11"/>
                        <TextBlock Grid.Column="5" Text="重置" Foreground="#EEF1F5" FontSize="11" Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- ===== DeepSeek 视图：今日 + flash/pro ===== -->
            <StackPanel Visibility="{Binding IsDeepSeekAccount, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding DeepSeekTotalLabel}" Foreground="#EEF1F5" FontSize="13"
                           FontWeight="SemiBold" Margin="0,2,0,4"/>
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DeepSeekFlash.Name}" Foreground="#C7CBD3" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding DeepSeekFlash.TokensLabel}" Foreground="#EEF1F5"
                               FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding DeepSeekFlash.CostLabel}" Foreground="#7FC9A0"
                               FontSize="12" Margin="10,0,0,0"/>
                </Grid>
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DeepSeekPro.Name}" Foreground="#C7CBD3" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding DeepSeekPro.TokensLabel}" Foreground="#EEF1F5"
                               FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding DeepSeekPro.CostLabel}" Foreground="#7FC9A0"
                               FontSize="12" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- ===== 探测/官方 API 视图：仅官方余额（模型列表已取消显示） ===== -->
            <StackPanel Visibility="{Binding IsProbePage, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding BalanceLabel}" Foreground="#7FC9A0" FontSize="12" FontWeight="SemiBold"
                           Visibility="{Binding BalanceLabel, Converter={StaticResource StrVis}}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- ===== 今日 token 消耗（zcode 本地数据，按页面 API key 归属；所有视图，设置可关） ===== -->
            <StackPanel Margin="0,6,0,0" Visibility="{Binding DailyBlockVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding DailyTotalLabel}" Foreground="#EEF1F5" FontSize="12" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding DailyRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#C7CBD3" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding TokensLabel}" Foreground="#EEF1F5"
                                           FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 底部：仅保留最后更新时间（与标题同色） -->
            <TextBlock HorizontalAlignment="Right" Text="{Binding LastSuccessLabel}" Foreground="#EEF1F5" FontSize="11"
                       Margin="0,6,0,0"/>
        </StackPanel>
    </Border>
</Window>
